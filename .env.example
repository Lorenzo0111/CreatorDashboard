# Sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Local file by default. For Turso: libsql://<database>-<org>.turso.io plus its auth token.
DATABASE_URL=file:./data/creator-dashboard.db
DATABASE_AUTH_TOKEN=

# Encrypts marketplace keys at rest. Changing it makes saved keys unreadable.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-32-byte-secret

# Protects /api/cron/refresh. Vercel Cron sends it automatically once it is set in the project.
CRON_SECRET=replace-with-a-random-string
